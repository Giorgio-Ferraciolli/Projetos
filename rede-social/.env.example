# Copie este arquivo para .env e ajuste se necessário:  cp .env.example .env
# Todos os valores abaixo são APENAS para desenvolvimento local. Sem o .env, o
# docker-compose.yml usa estes mesmos valores como padrão.

# ---------- Ambiente ----------
ENVIRONMENT=development

# ---------- Portas expostas no host ----------
FRONTEND_PORT=8080
BACKEND_PORT=8000
MYSQL_PORT=3306

# ---------- MySQL ----------
MYSQL_DATABASE=rede_social
MYSQL_USER=rede_social
MYSQL_PASSWORD=rede_social_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password

# ---------- Backend ----------
# Gere uma chave forte com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-key-change-me-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# true exige HTTPS para o navegador enviar o cookie de sessão (use em produção).
COOKIE_SECURE=false
# Origens extras permitidas (separadas por vírgula). Vazio: frontend e API na mesma origem.
CORS_ORIGINS=
MAX_UPLOAD_SIZE_MB=5
LOG_LEVEL=INFO
# json (estruturado, ideal para o Alloy/Loki) ou text (mais legível no terminal)
LOG_FORMAT=json
# Cria usuários, posts e comunidades de demonstração na primeira execução.
SEED_DEMO_DATA=true

# ---------- Observabilidade (opcional: docker compose --profile observability up) ----------
ALLOY_UI_PORT=12346
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USERNAME=
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_OTLP_USERNAME=
GRAFANA_CLOUD_API_TOKEN=
